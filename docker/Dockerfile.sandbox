# mcp-context: local stdio MCP server bridging internal/context/* (AST,
# dependency graph, RepoMap) and materialized skills to CLI agents running
# inside this sandbox. Built in its own stage so the final image doesn't need
# the full server module cache. See docs/openspecs/cli-orchestrator-update/.
FROM golang:1.26-bookworm AS mcpbuilder
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=1 go build -o /usr/local/bin/mcp-context ./cmd/mcp-context

FROM golang:1.26-bookworm

# Allow host to pass a custom UID/GID to avoid permission issues when mounting volumes
ARG USER_UID=1000
ARG USER_GID=1000

# Fix PIP PEP 668 to allow system-wide global installs in the sandbox without breaking
RUN mkdir -p /etc/pip && echo "[global]\nbreak-system-packages = true" > /etc/pip.conf

# CLI coding agents (claude, codex) require Node 22+; Debian bookworm's apt
# nodejs is only 18.x, so NodeSource replaces it instead of using apt's package.
# Optimization: Enable APT cache for faster rebuilds
RUN rm -f /etc/apt/apt.conf.d/docker-clean; echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        default-jdk \
        git \
        make \
        maven \
        patch \
        python3 \
        python3-pip \
        python3-pytest \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs

# CLI coding agents available to cli:* execution engine profiles (see
# web/src/lib/model-options.ts PROVIDERS). npm global installs land in
# /usr/local, already on PATH for every user.
# Optimization: Cache NPM downloads for faster rebuilds & clean local cache
RUN --mount=type=cache,target=/root/.npm \
    npm install -g @anthropic-ai/claude-code @openai/codex \
    && npm cache clean --force

COPY --from=mcpbuilder /usr/local/bin/mcp-context /usr/local/bin/mcp-context

RUN groupadd --gid ${USER_GID} agent \
    && useradd --uid ${USER_UID} --gid ${USER_GID} --create-home --shell /bin/bash agent

WORKDIR /workspace

USER root
# Explicitly set PATH so tools like antigravity are always accessible
ENV PATH="/usr/local/bin:${PATH}"
# The antigravity installer has no per-user variant of its own; it installs to
# $HOME/.local/bin. We temporarily set HOME=/root to install it as root, then
# move the binary to /usr/local/bin to keep /home/agent completely stateless.
RUN bash -c 'set -o pipefail; HOME=/root curl -fsSL https://antigravity.google/cli/install.sh | bash && mv /root/.local/bin/agy /usr/local/bin/agy && rm -rf /root/.local'

USER agent
CMD ["bash", "-c", "pwd && ls -la"]
